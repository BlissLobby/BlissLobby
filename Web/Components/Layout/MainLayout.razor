@inherits LayoutComponentBase
<style>
    /* Hide the checkbox state tracker */
    #sidebar-toggle {
        display: none;
    }

    /* Target Radzen's generated sidebar class */
    .custom-sidebar {
        display: none !important;
        width: 250px;
    }

    /* Make our label look like a Radzen button on hover */
    .custom-toggle-btn:hover {
        background-color: var(--rz-secondary-lighter);
        border-radius: var(--rz-border-radius-1);
    }

    /* Ensure the sidebar behaves correctly with the checkbox state */
    #sidebar-toggle:checked ~ .rz-layout .custom-sidebar {
        display: block !important;
    }

</style>

<RadzenComponents />

<!-- The invisible state tracker -->
<input type="checkbox" id="sidebar-toggle" class="sidebar-toggle-input" />

<RadzenLayout>
    <LayoutHeader />

    <LayoutSidebar />

    <RadzenBody>
        <div class="rz-p-4">
            <StatusMessage />
            @Body
        </div>
    </RadzenBody>
</RadzenLayout>
