@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@implements IDisposable

@inject NavigationManager NavigationManager

<RadzenHeader>
    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center" Style="width: 100%;">
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem" class="rz-p-2">
            <!-- This label triggers the checkbox in MainLayout -->
            <label for="sidebar-toggle" style="cursor: pointer; display: flex; align-items: center;" class="custom-toggle-btn">
                <RadzenIcon Icon="menu" />
            </label>
            <NavLink href="">
                <RadzenLabel Text="BlissLobby" Style="cursor: pointer;" />
            </NavLink>
        </RadzenStack>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem" class="rz-p-2">
            <AuthorizeView>
                <Authorized>
                    <RadzenProfileMenu>
                        <Template>
                            <RadzenGravatar Email="@context.User.FindFirst(ClaimTypes.Email)?.ToString()">
                            </RadzenGravatar>
                        </Template>
                        <ChildContent>
                            <RadzenProfileMenuItem Text="Profile" Path="account/profile" Icon="account_circle"></RadzenProfileMenuItem>
                            <form action="Account/Logout" method="post" name="logout">
                                <AntiforgeryToken />
                                <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                            </form>
                            <RadzenProfileMenuItem Text="Logout" Value="Logout" Icon="power_settings_new" Path="javascript:document.forms['logout'].submit();"></RadzenProfileMenuItem>
                        </ChildContent>
                    </RadzenProfileMenu>
                </Authorized>
                <NotAuthorized>
                    <RadzenLink Path="account/login" Text="Login" Variant="Variant.Text" />
                </NotAuthorized>
            </AuthorizeView>
        </RadzenStack>
    </RadzenStack>
</RadzenHeader>

@code {
    private string? currentUrl;

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}