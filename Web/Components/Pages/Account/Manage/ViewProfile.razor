@page "/account/profile"

@using App.Common.Interfaces
@using App.Common.Security
@using System.Security.Claims

@inject Radzen.DialogService DialogService
@inject IHttpContextAccessor HttpContextAccessor

<RadzenText TextStyle="TextStyle.H3" TagName="TagName.H1" Class="rz-mb-4">
    User Profile
</RadzenText>

<RadzenCard Class="rz-my-6 rz-mx-auto" Style="max-width: 600px;">
    <RadzenRow AlignItems="AlignItems.Center">
        <RadzenColumn Size="12" SizeMD="4" Class="rz-text-align-center">
            <!-- Read-only Avatar/Image -->
            <RadzenImage Path="user-avatar.png" Style="width: 100px; height: 100px; border-radius: 50%;" />
        </RadzenColumn>
        <RadzenColumn Size="12" SizeMD="8">
            <RadzenStack Gap="0.5rem">
                <div>
                    <RadzenText TextStyle="TextStyle.Overline" Class="rz-display-flex rz-mt-2 rz-mb-0">Username</RadzenText>
                    <RadzenText TextStyle="TextStyle.Body1"><b>@HttpContextAccessor.HttpContext?.User.Identity?.Name</b></RadzenText>
                </div>
                <div>
                    <RadzenText TextStyle="TextStyle.Overline" Class="rz-display-flex rz-mt-2 rz-mb-0">Name</RadzenText>
                    <RadzenText TextStyle="TextStyle.Body1"><b>@HttpContextAccessor.HttpContext?.User.FindFirst(ClaimTypes.GivenName)?.Value</b></RadzenText>
                </div>
                <div>
                    <RadzenText TextStyle="TextStyle.Overline" Class="rz-display-flex rz-mt-2 rz-mb-0">Email</RadzenText>
                    <RadzenText TextStyle="TextStyle.Body1"><b>@HttpContextAccessor.HttpContext?.User.FindFirst(ClaimTypes.Email)?.Value</b></RadzenText>
                </div>
                <div>
                    <RadzenText TextStyle="TextStyle.Overline" Class="rz-display-flex rz-mt-2 rz-mb-0">Roles</RadzenText>
                    <RadzenText TextStyle="TextStyle.Body1"><b>@string.Join(", ", HttpContextAccessor.HttpContext?.User.FindAll(ClaimTypes.Role).Select(c => c.Value) ?? [])</b></RadzenText>
                </div>
            </RadzenStack>
        </RadzenColumn>
    </RadzenRow>
</RadzenCard>
