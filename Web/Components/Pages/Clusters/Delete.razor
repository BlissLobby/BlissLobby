@page "/Clusters/Delete/{Id}"

@using App.Clusters.Queries.GetClusterForDisplay
@using App.Clusters.Commands.DeleteCluster
@using Web.Services

@inject IMediator mediator
@inject RedirectManager RedirectManager

<PageTitle>Delete Cluster</PageTitle>

<RadzenText TextStyle="TextStyle.H3" TagName="TagName.H1" Class="rz-mb-4">
    Delete Cluster
</RadzenText>

@if (Input == null)
{
    <p>Please wait...</p>
}
else
{
    <RadzenCard Class="rz-my-6 rz-mx-auto" Style="max-width: 600px;">
        <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="false" Class="rz-mb-4">
            <RadzenText TextStyle="TextStyle.Body2">
                <strong>Warning:</strong> This action cannot be undone. Are you sure you want to delete this cluster?
            </RadzenText>
        </RadzenAlert>

        <RadzenStack Gap="1rem" Class="rz-mb-4">
            <div>
                <RadzenText TextStyle="TextStyle.Overline" Class="rz-display-flex rz-mt-2 rz-mb-0">Name</RadzenText>
                <RadzenText TextStyle="TextStyle.Body1"><b>@Input.Name</b></RadzenText>
            </div>
            @if (!string.IsNullOrEmpty(Input.Description))
            {
                <div>
                    <RadzenText TextStyle="TextStyle.Overline" Class="rz-display-flex rz-mt-2 rz-mb-0">Description</RadzenText>
                    <RadzenText TextStyle="TextStyle.Body1"><b>@Input.Description</b></RadzenText>
                </div>
            }
            <div>
                <RadzenText TextStyle="TextStyle.Overline" Class="rz-display-flex rz-mt-2 rz-mb-0">Admins</RadzenText>
                <RadzenText TextStyle="TextStyle.Body1"><b>@string.Join(", ", Input.AdminNames)</b></RadzenText>
            </div>
        </RadzenStack>

        <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" JustifyContent="JustifyContent.End" AlignItems="AlignItems.Center">
            <EditForm Enhance Model="Input" method="post" OnSubmit="HandleDelete" FormName="deleteCluster">
                <InputHidden @bind-Value="Input.Id" Name="Cluster.Id" />
                <InputHidden @bind-Value="Input.Name" Name="Cluster.Name" />
                <RadzenButton ButtonType="ButtonType.Submit" 
                              Text="Delete Cluster" 
                              ButtonStyle="ButtonStyle.Danger" 
                              Size="ButtonSize.Large" />
            </EditForm>
        </RadzenStack>
    </RadzenCard>
}

<p><a href="/Clusters">Back to Clusters</a></p>

@code {
    [Parameter]
    public required string Id { get; set; }

    [SupplyParameterFromForm]
    public ClusterDto Input { get; set; } = default!;

    private async Task HandleDelete()
    {
        var result = await mediator.Send(new DeleteClusterCommand(Input.Id));

        if (result)
        {
            RedirectManager.RedirectToWithStatus("/Clusters", $"Cluster '{Input.Name}' has been deleted successfully", Radzen.AlertStyle.Success);
        }
        else
        {
            // Handle error case if needed
            RedirectManager.RedirectToWithStatus("/Error", "An error occurred while deleting the cluster.", Radzen.AlertStyle.Danger);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var cluster = await mediator.Send(new GetClusterForDisplayQuery(Id));

        if (cluster == null)
        {
            RedirectManager.RedirectTo("/not-found", true);
            return;
        }

        Input = cluster;
    }
}
