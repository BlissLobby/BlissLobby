@page "/users/create"
@attribute [StreamRendering]

@using App.Buildings.Queries.GetBuildings
@using App.Common.Interfaces
@using App.Users.Commands.CreateUser
@using Blazilla
@using Domain.Entities
@using System.ComponentModel.DataAnnotations


@inject IMediator mediator

<PageTitle>Create user</PageTitle>

<RadzenText TextStyle="TextStyle.H3" TagName="TagName.H1">Create User</RadzenText>
<RadzenRow Gap="1rem">
    <RadzenColumn SizeSM="4">
        <RadzenCard Variant="Variant.Flat" Class="rz-p-4 rz-p-lg-12">
            <EditForm Enhance EditContext="editContext" method="post" OnSubmit="HandleSubmit" FormName="createUser">
                <FluentValidator AsyncMode="true" />
                <RadzenAlert Visible="@(!editContext.Validate() && editContext.GetValidationMessages().Any())"
                             AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" Shade="Shade.Lighter"
                             AllowClose="false">
                    <ValidationSummary />
                </RadzenAlert>

                <RadzenStack Gap="1rem">
                    <RadzenFormField Text="Username" Variant="Variant.Outlined">
                        <RadzenTextBox @bind-Value="Input.Username" Name="Input.Username" style="width: 100%;"
                                       aria-required="true" />
                    </RadzenFormField>
                    <ValidationMessage For="() => Input.Username" class="rz-text-danger rz-mb-2" />

                    <RadzenFormField Text="Display Name" Variant="Variant.Outlined">
                        <RadzenTextBox @bind-Value="Input.DisplayName" Name="Input.DisplayName" style="width: 100%;"
                                       aria-required="true" />
                    </RadzenFormField>
                    <ValidationMessage For="() => Input.Username" class="rz-text-danger rz-mb-2" />

                    <RadzenFormField Text="Email" Variant="Variant.Outlined">
                        <RadzenTextBox @bind-Value="Input.Email" Name="Input.Email" style="width: 100%;"
                                       aria-required="true" />
                    </RadzenFormField>
                    <ValidationMessage For="() => Input.Email" class="rz-text-danger rz-mb-2" />

                    <RadzenFormField Text="Phone Number (Optional)" Variant="Variant.Outlined">
                        <RadzenTextBox @bind-Value="Input.PhoneNumber" Name="Input.PhoneNumber" style="width: 100%;"
                                       aria-required="false" />
                    </RadzenFormField>
                    <ValidationMessage For="() => Input.PhoneNumber" class="rz-text-danger rz-mb-2" />

                    <RadzenFormField Text="Password" Variant="Variant.Outlined">
                        <RadzenPassword @bind-Value="Input.Password" Name="Input.Password" style="width: 100%;"
                                        aria-required="true" />
                    </RadzenFormField>
                    <ValidationMessage For="() => Input.Password" class="rz-text-danger rz-mb-2" />

                    <RadzenFormField Text="Confirm Password" Variant="Variant.Outlined">
                        <RadzenPassword @bind-Value="Input.ConfirmPassword" Name="Input.ConfirmPassword" style="width: 100%;"
                                        aria-required="true" />
                    </RadzenFormField>
                    <ValidationMessage For="() => Input.ConfirmPassword" class="rz-text-danger rz-mb-2" />

                    @* TODO: create a reusable SSR Radzen dropdown component *@
                    <RadzenFormField Text="User Role" Variant="Variant.Outlined">
                        <div class="rz-dropdown rz-state-default" style="width: 100%; display: flex; align-items: center;">
                            <select name="Input.UserRole" class="rz-dropdown-label rz-inputtext"
                                    style="appearance: none; background: transparent; border: none; width: 100%; outline: none; padding: 0.5rem;">
                                <option value="">Select a Role...</option>
                                @foreach (var role in Roles.GetRoles())
                                {
                                    if (!role.Equals(Roles.Administrator))
                                    {
                                        <option value="@role">@role</option>
                                    }
                                }
                            </select>
                            @* Radzen's dropdown arrow icon *@
                            <i class="rz-dropdown-trigger rz-state-default rz-corner-right" style="padding: 0 10px;">
                                <span class="rz-dropdown-trigger-icon rzi rzi-chevron-down"></span>
                            </i>
                        </div>
                    </RadzenFormField>
                    <ValidationMessage For="() => Input.UserRole" class="rz-text-danger rz-mb-2" />

                    @* TODO: create a reusable SSR Radzen checkbox component *@
                    <div class="rz-display-flex rz-align-center rz-mb-4">
                        <div class="rz-chkbox">
                            @* Native checkbox for SSR interaction *@
                            <InputCheckbox type="checkbox"
                                           name="Input.IsTwoFactorEnabled"
                                           @bind-Value="@Input.IsTwoFactorEnabled"
                                           class="rz-chkbox-box" />
                        </div>
                        <label class="rz-label" for="Input.IsTwoFactorEnabled">Enable Two-Factor Authentication</label>
                    </div>

                    <div class="rz-display-flex rz-align-center rz-mb-4">
                        <div class="rz-chkbox">
                            @* Native checkbox for SSR interaction *@
                            <InputCheckbox type="checkbox"
                                           name="Input.IsEmailConfirmed"
                                           @bind-Value="@Input.IsEmailConfirmed"
                                           class="rz-chkbox-box" />
                        </div>
                        <label class="rz-label" for="Input.IsEmailConfirmed">Confirm Email</label>
                    </div>

                    <div class="rz-display-flex rz-align-center rz-mb-4">
                        <div class="rz-chkbox">
                            @* Native checkbox for SSR interaction *@
                            <InputCheckbox type="checkbox"
                                           name="Input.IsPhoneConfirmed"
                                           @bind-Value="@Input.IsPhoneConfirmed"
                                           class="rz-chkbox-box" />
                        </div>
                        <label class="rz-label" for="Input.IsPhoneConfirmed">Confirm Phone</label>
                    </div>

                    <RadzenFormField Text="Building" Variant="Variant.Outlined">
                        <div class="rz-dropdown rz-state-default" style="width: 100%; display: flex; align-items: center;">
                            <select name="Input.BuildingId" class="rz-dropdown-label rz-inputtext"
                                    style="appearance: none; background: transparent; border: none; width: 100%; outline: none; padding: 0.5rem;">
                                <option value="">Select a Building...</option>
                                @foreach (var building in Buildings)
                                {
                                    <option value="@building.Id">@building.Name</option>
                                }
                            </select>
                            @* Radzen's dropdown arrow icon *@
                            <i class="rz-dropdown-trigger rz-state-default rz-corner-right" style="padding: 0 10px;">
                                <span class="rz-dropdown-trigger-icon rzi rzi-chevron-down"></span>
                            </i>
                        </div>
                    </RadzenFormField>
                    <ValidationMessage For="() => Input.BuildingId" class="rz-text-danger rz-mb-2" />

                    <RadzenButton ButtonType="ButtonType.Submit" Text="Create User"
                                  ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Large" FullWidth="true" />

                </RadzenStack>
            </EditForm>
        </RadzenCard>
    </RadzenColumn>
</RadzenRow>

<p><a href="/users">Back to List</a></p>



@code {
    private EditContext editContext = default!;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private CreateUserCommand Input { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    private List<Building> Buildings { get; set; } = new();

    private async Task HandleSubmit()
    {
        var isValid = await editContext.ValidateAsync();
        if (isValid)
        {
            await mediator.Send(Input);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        // TODO: access whether this line is required
        Input ??= new();
        editContext = new EditContext(Input);

        Buildings = await mediator.Send(new GetBuildingsQuery());
    }
}