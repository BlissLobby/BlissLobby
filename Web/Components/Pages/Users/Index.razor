@page "/Users"
@attribute [StreamRendering]

@using App.Common.Pagination
@using App.Users.Queries.GetUsersForDisplay
@using Domain.Entities
@using Nagasudhir.SmartStaticGrid.Components
@using Nagasudhir.SmartStaticGrid.Models

@inject IMediator mediator

<PageTitle>Users</PageTitle>

<h1>Users</h1>

<SmartStaticGrid Id="RadzenStyledUsers"
                 TItem="UserListDto"
                 Columns="userCols"
                 DataProvider="LoadUsers"
                 TableClass="rz-grid-table rz-datatable"
                 HeaderClass="rz-column-title"
                 RowClass="rz-datatable-even"
                 PagerContainerClass="rz-paginator"
                 PageSizeOptions=@(new int[] {10,20,50})>

    <RowTemplate Context="user">
        <td class="rz-grid-col-text">@user.UserName</td>
        <td class="rz-grid-col-text">@user.DisplayName</td>
        <td class="rz-grid-col-text">@user.Email</td>
        <td class="rz-grid-col-text">@user.EmailConfirmed</td>
        <td class="rz-grid-col-text">@string.Join(", ", user.Roles)</td>
        <td class="rz-grid-col-text">
            <a href="/Users/Details/@user.Id">View</a>
            <a href="/Users/Edit/@user.Id">Edit</a>
        </td>
    </RowTemplate>

    <EmptyTemplate>
        <div class="rz-p-12 rz-text-align-center">
            <RadzenIcon Icon="find_in_page" Style="font-size: 3rem;" />
            <p>No users found.</p>
        </div>
    </EmptyTemplate>

</SmartStaticGrid>

<p><a href="/Users/Create">Create New User</a></p>

@code {
    public static readonly List<ColumnDef> userCols = [
        new(nameof(ApplicationUser.UserName), "User Name", Searchable: true),
        new(nameof(ApplicationUser.DisplayName), "Name", Searchable: true),
        new(nameof(ApplicationUser.Email), "Email", Searchable: true),
        new(nameof(UserListDto.EmailConfirmed), "Email Confirmed", Searchable: false),
        new(nameof(UserListDto.Roles), "Roles", Searchable: false),
        new("Actions", "Actions", Searchable: false),
    ];

    private async Task<GridResponse<UserListDto>> LoadUsers(GridRequest req)
    {
        // Simulate asynchronous loading to check ui responsiveness
        // await Task.Delay(3000);

        var (users, totalCount) = await mediator.Send(
                    new GetUsersForDisplayQuery(
                        new PaginationQuery(req.Page, req.PageSize, req.Filters,
                                            req.SortBy, req.SortDesc, req.RequestNewCount
                        )
                    )
                );
        return new GridResponse<UserListDto>(users, totalCount);
    }
}
